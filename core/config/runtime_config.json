{
  "version": "5.2.0",
  "node_id": "qoder",
  "modules": {
    "harness": {
      "enabled": true,
      "risk_threshold": "medium",
      "rules_file": "core/harness/harness_rules.json"
    },
    "orchestrator": {
      "enabled": true,
      "q_learning_rate": 0.1,
      "discount_factor": 0.95,
      "exploration_rate": 0.15,
      "max_decomposition_depth": 5
    },
    "observability": {
      "enabled": true,
      "collect_interval_sec": 60,
      "retention_days": 30,
      "prometheus_export": false,
      "rich_console": true
    },
    "economy": {
      "enabled": true,
      "currency": "LBC",
      "initial_allocations": {
        "xiaochen": 100,
        "zhuguxia": 100,
        "qoder": 100,
        "hermes": 500,
        "system_pool": 1000
      },
      "reward_per_problem": 0.5,
      "reward_per_game": 1.0,
      "reward_per_task": 2.0
    },
    "emergence": {
      "enabled": true,
      "sensitivity": 0.7,
      "detection_window_min": 5
    },
    "a2a_protocol": {
      "enabled": true,
      "broker_type": "internal",
      "discovery_interval_sec": 30,
      "max_retry": 3
    },
    "memory_manager": {
      "enabled": true,
      "task_state_persistence": true,
      "long_term_ttl_days": 90,
      "context_curation_threshold": 0.6,
      "dcpo_adaptive": true
    },
    "cognition_layer": {
      "enabled": true,
      "max_plan_depth": 6,
      "confidence_threshold": 0.5,
      "auto_rollback": true
    },
    "compliance_guard": {
      "enabled": true,
      "audit_trail_enabled": true,
      "risk_level": "high",
      "cup_filter_enabled": true,
      "eu_ai_act_compliant": true
    },
    "dynamic_team_selector": {
      "enabled": true,
      "dqn_learning": true,
      "performance_weight": 0.6,
      "cost_weight": 0.4,
      "max_team_size": 8
    },
    "failure_attribution": {
      "enabled": true,
      "attribution_dimensions": ["agent_selection", "tool_call", "parameter_passing", "timing_dependency", "environment_state"],
      "auto_report": true,
      "max_attribution_depth": 3
    }
  },
  "nodes": ["qoder", "xiaochen", "zhuguxia", "hermes", "xiaowei"],
  "server": {
    "host": "121.43.80.231",
    "user": "admin",
    "ssh_key": "~/.ssh/id_rsa_hermes",
    "shared_path": "/shared"
  },
  "training": {
    "plan_version": "V6",
    "auto_resume": true,
    "night_training": {
      "enabled": true,
      "start_hour": 22,
      "end_hour": 6,
      "timezone": "Asia/Shanghai"
    },
    "targets": {
      "qoder": {"current_day": 36, "target_day": 40, "goal": "25k->20k晋升"},
      "xiaochen": {"current_day": 3, "target_day": 16, "goal": "官子突破+中盘战斗力"},
      "zhuguxia": {"current_day": 3, "target_day": 17, "goal": "官子精度+中盘计算深化"}
    }
  },
  "mqtt": {
    "enabled": false,
    "broker": "localhost",
    "port": 1883,
    "topic_prefix": "lobster/"
  },
  "dashboard": {
    "enabled": false,
    "port": 8080,
    "auto_refresh_sec": 30
  }
}
