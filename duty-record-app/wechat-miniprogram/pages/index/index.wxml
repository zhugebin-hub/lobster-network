<view class="container">
  <!-- 欢迎区域 -->
  <view class="welcome">
    <text class="title">🏫 学校值班记录系统</text>
    <text class="subtitle">初中部 · 3 年级 24 班</text>
  </view>

  <!-- 用户信息 -->
  <view class="user-info" wx:if="{{userInfo}}">
    <text class="greeting">你好，{{userInfo.name}}</text>
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 功能入口 -->
  <view class="menu-grid">
    <view class="menu-item" bindtap="goToRecord">
      <text class="icon">📝</text>
      <text class="label">值班记录</text>
    </view>
    <view class="menu-item" bindtap="goToView">
      <text class="icon">👁️</text>
      <text class="label">查看记录</text>
    </view>
    <view class="menu-item" bindtap="goToWeekly">
      <text class="icon">📊</text>
      <text class="label">周报总结</text>
    </view>
    <view class="menu-item" bindtap="goToLogin" wx:if="{{!userInfo}}">
      <text class="icon">👤</text>
      <text class="label">管理员登录</text>
    </view>
  </view>

  <!-- 今日概览 -->
  <view class="today-section">
    <text class="section-title">📅 今日值班</text>
    <view class="today-stats">
      <view class="stat-item">
        <text class="stat-num">{{todayCount}}</text>
        <text class="stat-label">已记录</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{todayAvg}}</text>
        <text class="stat-label">平均分</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <button class="action-btn" bindtap="quickRecord">➕ 快速记录</button>
    <button class="action-btn secondary" bindtap="viewToday">📋 今日汇总</button>
  </view>
</view>
