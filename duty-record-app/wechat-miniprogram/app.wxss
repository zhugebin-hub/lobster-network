/* 全局样式 */
page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 30rpx;
}

/* 首页样式 */
.welcome {
  text-align: center;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #4A90D9 0%, #67B26F 100%);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-top: 10rpx;
}

.user-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.greeting {
  font-size: 28rpx;
  color: #333;
}

.logout-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: #ff6b6b;
  color: #fff;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.menu-item {
  background: #fff;
  padding: 40rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.menu-item .icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 10rpx;
}

.menu-item .label {
  font-size: 26rpx;
  color: #666;
}

.today-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.today-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90D9;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  background: #4A90D9;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}

.action-btn.secondary {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
}

/* 登录页样式 */
.login-container {
  padding: 60rpx 40rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-header .title {
  font-size: 40rpx;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.login-header .subtitle {
  font-size: 28rpx;
  color: #999;
}

.login-form .form-item {
  margin-bottom: 40rpx;
}

.login-form .label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.login-form .input {
  background: #fff;
  padding: 24rpx 30rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.login-btn {
  background: #4A90D9;
  color: #fff;
  font-size: 32rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  margin-top: 40rpx;
}

.tips {
  margin-top: 40rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

/* 记录页样式 */
.record-container {
  padding: 30rpx;
}

.form-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.record-form .form-item {
  margin-bottom: 30rpx;
}

.record-form .label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.record-form .picker {
  background: #fff;
  padding: 24rpx 30rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.score-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.score-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-item:last-child {
  margin-bottom: 0;
}

.score-label {
  width: 100rpx;
  font-size: 28rpx;
}

.score-stars {
  flex: 1;
  display: flex;
  gap: 10rpx;
}

.star {
  font-size: 40rpx;
  color: #ddd;
}

.star.active {
  color: #ffd700;
}

.score-num {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  color: #4A90D9;
  font-weight: bold;
}

.textarea {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  min-height: 150rpx;
  font-size: 28rpx;
}

.photo-upload {
  width: 200rpx;
  height: 200rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-upload image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.upload-placeholder .icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.upload-placeholder .tip {
  font-size: 24rpx;
  color: #999;
}

.submit-btn {
  background: #4A90D9;
  color: #fff;
  font-size: 32rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  margin-top: 40rpx;
}

/* 周报页样式 */
.weekly-container {
  padding: 30rpx;
}

.weekly-container .header {
  text-align: center;
  margin-bottom: 40rpx;
}

.weekly-container .title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.weekly-container .subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.date-range {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.date-item {
  margin-bottom: 20rpx;
}

.date-item .label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.generate-btn {
  background: #4A90D9;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.summary-card {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #4A90D9;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.summary-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
}

.ranking-section .section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.ranking-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #eee;
  text-align: center;
  line-height: 50rpx;
  font-size: 26rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.rank-num.top {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #fff;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}

.rank-score {
  font-size: 24rpx;
  color: #4A90D9;
  display: block;
  margin-top: 5rpx;
}

.rank-detail {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
