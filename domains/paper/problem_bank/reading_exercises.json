{
  "version": "1.0",
  "description": "论文阅读理解练习题库",
  "total_exercises": 20,
  "categories": ["methodology", "experiment", "writing", "critical_thinking"],
  "exercises": [
    {
      "id": "R001",
      "category": "methodology",
      "difficulty": "初段",
      "title": "摘要信息提取",
      "instruction": "阅读给定论文摘要，回答以下问题：1) 研究问题是什么？2) 提出什么方法？3) 主要结论是什么？",
      "time_limit_min": 15,
      "scoring": {
        "research_question": 30,
        "method": 30,
        "conclusion": 30,
        "clarity": 10
      }
    },
    {
      "id": "R002",
      "category": "methodology",
      "difficulty": "二段",
      "title": "方法论复述",
      "instruction": "阅读论文方法章节后，不看原文，用自己的话描述：1) 整体技术路线 2) 核心算法步骤 3) 关键假设",
      "time_limit_min": 30,
      "scoring": {
        "technical_route": 35,
        "algorithm_steps": 35,
        "assumptions": 20,
        "clarity": 10
      }
    },
    {
      "id": "R003",
      "category": "experiment",
      "difficulty": "三段",
      "title": "实验设计评估",
      "instruction": "阅读论文实验部分，评估：1) 数据集选择是否合理 2) 基线方法是否充分 3) 评估指标是否恰当 4) 是否有遗漏的实验",
      "time_limit_min": 40,
      "scoring": {
        "dataset_eval": 25,
        "baseline_eval": 25,
        "metric_eval": 25,
        "gap_analysis": 25
      }
    },
    {
      "id": "R004",
      "category": "critical_thinking",
      "difficulty": "四段",
      "title": "批判性分析",
      "instruction": "选择一篇论文，写出：1) 3个优点 2) 3个局限性 3) 2个可能的改进方向 4) 对你自己研究的启发",
      "time_limit_min": 45,
      "scoring": {
        "strengths": 20,
        "limitations": 25,
        "improvements": 25,
        "relevance": 20,
        "depth": 10
      }
    },
    {
      "id": "R005",
      "category": "methodology",
      "difficulty": "五段",
      "title": "文献关系图",
      "instruction": "给定5篇相关论文，绘制它们的关系图：1) 标注每篇论文的核心贡献 2) 标注论文之间的继承/对立/互补关系 3) 指出研究空白",
      "time_limit_min": 60,
      "scoring": {
        "contributions": 25,
        "relationships": 30,
        "gap_identification": 25,
        "visualization": 20
      }
    },
    {
      "id": "R006",
      "category": "writing",
      "difficulty": "六段",
      "title": "文献综述片段",
      "instruction": "基于3篇相关论文，撰写一段800字的文献综述，要求：1) 逻辑连贯 2) 有批判性分析 3) 自然引出研究空白",
      "time_limit_min": 90,
      "scoring": {
        "coverage": 20,
        "logic": 25,
        "critical_analysis": 25,
        "gap_transition": 20,
        "writing_quality": 10
      }
    },
    {
      "id": "R007",
      "category": "critical_thinking",
      "difficulty": "七段",
      "title": "研究提案",
      "instruction": "基于精读的论文，提出一个新的研究问题：1) 问题定义 2) 动机与意义 3) 初步方案 4) 预期贡献 5) 潜在风险",
      "time_limit_min": 120,
      "scoring": {
        "novelty": 25,
        "feasibility": 20,
        "significance": 20,
        "methodology": 25,
        "risk_analysis": 10
      }
    },
    {
      "id": "R008",
      "category": "experiment",
      "difficulty": "三段",
      "title": "实验结果解读",
      "instruction": "给定一张实验结果表格，分析：1) 哪些方法表现最好/最差 2) 为什么会出现这样的结果 3) 结果是否有统计显著性 4) 结果对实际应用的启示",
      "time_limit_min": 30,
      "scoring": {
        "result_identification": 25,
        "causal_analysis": 30,
        "statistical_awareness": 20,
        "practical_implications": 25
      }
    },
    {
      "id": "R009",
      "category": "writing",
      "difficulty": "四段",
      "title": "摘要写作",
      "instruction": "阅读一篇完整论文（隐去摘要），自己撰写中文摘要（150-200字）和英文摘要（200+词），与原文对比",
      "time_limit_min": 45,
      "scoring": {
        "chinese_abstract": 30,
        "english_abstract": 30,
        "coverage": 20,
        "conciseness": 20
      }
    },
    {
      "id": "R010",
      "category": "methodology",
      "difficulty": "五段",
      "title": "跨论文方法比较",
      "instruction": "选择2篇解决相似问题的论文，比较：1) 方法论差异 2) 各自的优劣 3) 在什么场景下各自更适用 4) 能否融合两者优点",
      "time_limit_min": 60,
      "scoring": {
        "method_comparison": 25,
        "pros_cons": 25,
        "scenario_analysis": 25,
        "fusion_idea": 25
      }
    },
    {
      "id": "R011",
      "category": "experiment",
      "difficulty": "四段",
      "title": "消融实验设计",
      "instruction": "给定一个包含3个组件的系统，设计消融实验：1) 实验组合 2) 预期结果 3) 如何证明每个组件的必要性",
      "time_limit_min": 40,
      "scoring": {
        "experiment_combinations": 30,
        "expected_results": 25,
        "necessity_proof": 30,
        "completeness": 15
      }
    },
    {
      "id": "R012",
      "category": "writing",
      "difficulty": "六段",
      "title": "引言写作",
      "instruction": "选择一个研究方向，撰写1500字引言，包含：1) 背景与动机 2) 现有工作的不足 3) 本文的贡献 4) 论文组织结构",
      "time_limit_min": 90,
      "scoring": {
        "background": 20,
        "gap_identification": 25,
        "contributions": 30,
        "structure": 15,
        "writing_quality": 10
      }
    },
    {
      "id": "R013",
      "category": "critical_thinking",
      "difficulty": "五段",
      "title": "审稿模拟",
      "instruction": "扮演审稿人评审一篇同伴论文草稿，写出：1) 主要优点(2条) 2) 主要问题(3条) 3) 改进建议 4) 总体评价(accept/minor/major/reject)",
      "time_limit_min": 60,
      "scoring": {
        "constructive_feedback": 30,
        "problem_identification": 30,
        "suggestions": 25,
        "overall_judgment": 15
      }
    },
    {
      "id": "R014",
      "category": "methodology",
      "difficulty": "三段",
      "title": "算法伪代码阅读",
      "instruction": "给定一段算法伪代码，回答：1) 输入输出是什么 2) 核心循环做了什么 3) 时间复杂度是多少 4) 什么情况下会失效",
      "time_limit_min": 30,
      "scoring": {
        "io_identification": 20,
        "loop_understanding": 30,
        "complexity_analysis": 25,
        "failure_cases": 25
      }
    },
    {
      "id": "R015",
      "category": "writing",
      "difficulty": "七段",
      "title": "回复审稿意见",
      "instruction": "给定3条审稿意见（1条小修、2条大修），撰写正式的回复信：1) 礼貌开头 2) 逐条回复 3) 说明修改内容 4) 补充实验/分析",
      "time_limit_min": 90,
      "scoring": {
        "tone": 15,
        "completeness": 25,
        "revision_quality": 30,
        "additional_evidence": 20,
        "format": 10
      }
    },
    {
      "id": "R016",
      "category": "methodology",
      "difficulty": "二段",
      "title": "关键词与分类",
      "instruction": "阅读论文全文，给出：1) 3-5个关键词 2) ACM/CCF分类 3) 一句话概括 4) 适合投稿的3个期刊/会议",
      "time_limit_min": 20,
      "scoring": {
        "keywords": 25,
        "classification": 25,
        "summary": 25,
        "venue_suggestion": 25
      }
    },
    {
      "id": "R017",
      "category": "experiment",
      "difficulty": "五段",
      "title": "实验复现评估",
      "instruction": "给定论文的方法描述和代码（或伪代码），评估：1) 哪些部分容易复现 2) 哪些部分缺乏细节 3) 需要补充什么信息才能完整复现",
      "time_limit_min": 45,
      "scoring": {
        "reproducibility_assessment": 30,
        "detail_gap_analysis": 35,
        "supplement_suggestions": 25,
        "practical_awareness": 10
      }
    },
    {
      "id": "R018",
      "category": "critical_thinking",
      "difficulty": "六段",
      "title": "研究脉络梳理",
      "instruction": "给定一个研究方向（如多Agent协作），阅读5-8篇代表性论文，撰写1500字的研究脉络梳理：1) 发展历史 2) 关键里程碑 3) 当前前沿 4) 未来趋势",
      "time_limit_min": 120,
      "scoring": {
        "historical_coverage": 20,
        "milestone_accuracy": 25,
        "frontier_analysis": 25,
        "trend_prediction": 20,
        "writing_quality": 10
      }
    },
    {
      "id": "R019",
      "category": "writing",
      "difficulty": "四段",
      "title": "图表说明写作",
      "instruction": "给定3张实验图表（折线图/柱状图/表格），各撰写100字说明，要求：1) 描述趋势/差异 2) 解释原因 3) 指出关键发现",
      "time_limit_min": 30,
      "scoring": {
        "trend_description": 30,
        "causal_explanation": 30,
        "key_findings": 25,
        "conciseness": 15
      }
    },
    {
      "id": "R020",
      "category": "methodology",
      "difficulty": "八段",
      "title": "完整方法论章节",
      "instruction": "选择一个研究问题，撰写完整的方法论章节（3000-4000字）：1) 问题形式化定义 2) 整体框架描述 3) 核心算法 4) 复杂度分析 5) 实现细节",
      "time_limit_min": 180,
      "scoring": {
        "formalization": 20,
        "framework": 20,
        "algorithm": 25,
        "analysis": 20,
        "implementation": 15
      }
    }
  ]
}
