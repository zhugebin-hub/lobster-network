{
  "expo": {
    "name": "小龙虾网络",
    "slug": "lobster-network",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1890ff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lobster.network"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1890ff"
      },
      "package": "com.lobster.network"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
